# Every variable here has a working default in app/core/config.py, so local
# development needs no .env at all. These matter in a deployment.

# SQLAlchemy URL. Defaults to a SQLite file in backend/. On Render's free plan
# the disk is ephemeral, so this is rebuilt and reseeded on each deploy; point
# it at a mounted disk to keep writes across deploys.
DATABASE_URL=sqlite:///./salary.db

# Origins allowed to call the API, as a JSON array — pydantic-settings parses
# list fields as JSON, so a bare URL fails validation at startup. No trailing
# slash: browsers never send one in the Origin header, and the mismatch makes
# preflight fail with a 400 and no allow-origin header.
CORS_ORIGINS=["https://your-app.vercel.app"]

# Currency that salaries are normalized to for comparison and reporting.
BASE_CURRENCY=USD
